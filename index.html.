<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LYS Auto Care | Exklusive Detailing-Geschenkboxen</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    
    <style>
        :root {
            --bg-dark: #0D0D0D;
            --bg-card: #151515;
            --bg-card-hover: #1C1C1C;
            --bronze: #C58348;
            --bronze-light: #DF9E62;
            --bronze-dark: #8F5826;
            --text-light: #F5F5F7;
            --text-muted: #9E9EA6;
            --border-color: rgba(197, 131, 72, 0.3);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        
        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ПРЕМИАЛЬНЫЙ ВИДЕОФОН */
        .video-bg-container {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -2;
            overflow: hidden;
            background: #080808;
        }

        .video-bg-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.28;
            filter: contrast(1.1) brightness(0.8);
        }

        .video-overlay {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1;
            background: radial-gradient(circle at center, rgba(13, 13, 13, 0.5) 0%, rgba(13, 13, 13, 0.94) 100%);
            pointer-events: none;
        }

        /* УВЕДОМЛЕНИЯ (TOAST) */
        .toast-notification {
            position: fixed; top: 25px; right: 25px; background: var(--bg-card); color: var(--text-light);
            padding: 14px 24px; border-radius: 12px; border: 1px solid var(--bronze);
            box-shadow: 0 10px 30px rgba(0,0,0,0.6); font-size: 14px; font-weight: 600;
            z-index: 999999; display: none; align-items: center; gap: 10px; animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ПРОМО-БАННЕР */
        .promo-banner {
            background: linear-gradient(90deg, #121212 0%, #1F1710 50%, #121212 100%);
            color: var(--text-light); padding: 11px 8%; text-align: center;
            font-size: 13px; font-weight: 500; display: flex; justify-content: center; align-items: center;
            gap: 15px; flex-wrap: wrap; border-bottom: 1px solid var(--border-color);
        }

        .promo-badge { background: var(--bronze); color: #0D0D0D; padding: 3px 10px; border-radius: 6px; font-weight: 800; letter-spacing: 0.5px; }
        .promo-btn {
            background: transparent; color: var(--bronze-light); padding: 5px 14px; border-radius: 20px;
            font-weight: 700; font-size: 12px; cursor: pointer; border: 1px solid var(--bronze); transition: all 0.3s ease;
        }
        .promo-btn:hover { background: var(--bronze); color: #0D0D0D; transform: scale(1.05); }

        /* ШАПКА САЙТА */
        header {
            display: flex; justify-content: space-between; align-items: center; padding: 18px 8%;
            background: rgba(13, 13, 13, 0.88); backdrop-filter: blur(16px); position: sticky;
            top: 0; z-index: 1000; border-bottom: 1px solid var(--border-color);
        }

        .logo-group { display: flex; align-items: center; gap: 14px; text-decoration: none; }
        
        .logo-icon-card {
            width: 48px; height: 48px; background: #141414; border: 1.5px solid var(--bronze);
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 15px rgba(197, 131, 72, 0.15); transition: transform 0.3s ease;
            overflow: hidden;
        }
        .logo-icon-card img { width: 85%; height: 85%; object-fit: contain; }
        .logo-group:hover .logo-icon-card { transform: scale(1.06); border-color: var(--bronze-light); }

        .logo-text { font-family: 'Cinzel', serif; font-size: 26px; font-weight: 800; color: var(--bronze); letter-spacing: 2px; }
        .logo-text span { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 600; color: var(--text-muted); display: block; letter-spacing: 1.5px; text-transform: uppercase; margin-top: -3px; }

        nav { display: flex; align-items: center; gap: 24px; }
        nav a { text-decoration: none; color: var(--text-light); font-size: 14px; font-weight: 600; transition: color 0.2s; letter-spacing: 0.3px; }
        nav a:hover { color: var(--bronze); }

        .lang-switch {
            display: flex; align-items: center; background: rgba(255, 255, 255, 0.05);
            padding: 4px 6px; border-radius: 20px; gap: 4px; font-size: 12px; font-weight: 700;
            border: 1px solid rgba(197, 131, 72, 0.2);
        }

        .lang-btn {
            border: none; background: none; color: var(--text-muted); cursor: pointer;
            padding: 4px 8px; border-radius: 12px; transition: all 0.25s ease; font-family: inherit; font-weight: 700;
        }
        .lang-btn.active { background: var(--bronze); color: #0D0D0D; }

        .btn-shop-header {
            background: linear-gradient(135deg, var(--bronze) 0%, var(--bronze-dark) 100%);
            color: #0D0D0D; padding: 11px 22px; border-radius: 30px; font-size: 14px; font-weight: 800;
            display: inline-flex; align-items: center; gap: 8px; cursor: pointer; border: none;
            transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(197, 131, 72, 0.25); font-family: inherit;
        }
        .btn-shop-header:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(197, 131, 72, 0.45); background: var(--bronze-light); }

        /* ГЛАВНЫЙ ЭКРАН (HERO) */
        .hero-container { max-width: 1100px; margin: 0 auto; padding: 90px 8% 80px; text-align: center; }
        .edition-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(197, 131, 72, 0.12); border: 1px solid var(--bronze);
            color: var(--bronze-light); padding: 7px 18px; border-radius: 30px;
            font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 24px;
        }
        .hero-title { font-size: 54px; line-height: 1.15; font-weight: 800; color: var(--text-light); margin-bottom: 22px; letter-spacing: -0.5px; }
        .hero-title em { font-style: normal; color: var(--bronze); font-family: 'Cinzel', serif; }
        .hero-desc { font-size: 18px; line-height: 1.65; color: var(--text-muted); max-width: 720px; margin: 0 auto 38px; }

        .btn-angebot-cta {
            background: linear-gradient(135deg, var(--bronze-light) 0%, var(--bronze) 100%);
            color: #0D0D0D; padding: 18px 42px; border-radius: 14px; font-size: 16px; font-weight: 800;
            border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 12px;
            transition: all 0.35s ease; box-shadow: 0 10px 30px rgba(197, 131, 72, 0.35); font-family: inherit;
            text-transform: uppercase; letter-spacing: 0.8px;
        }
        .btn-angebot-cta:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 16px 40px rgba(197, 131, 72, 0.55); }

        /* ПРЕИМУЩЕСТВА */
        .perks-bar { max-width: 1250px; margin: 0 auto 80px; padding: 0 8%; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; }
        .perk-item {
            background: rgba(21, 21, 21, 0.9); backdrop-filter: blur(12px); border: 1px solid var(--border-color);
            padding: 22px 24px; border-radius: 18px; display: flex; align-items: center; gap: 16px;
            transition: all 0.3s ease;
        }
        .perk-item:hover { transform: translateY(-5px); border-color: var(--bronze); background: var(--bg-card-hover); }
        .perk-icon-wrapper {
            width: 46px; height: 46px; background: rgba(197, 131, 72, 0.12); border: 1px solid rgba(197, 131, 72, 0.3);
            border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;
        }
        .perk-title { font-size: 15px; font-weight: 700; color: var(--text-light); }

        /* ЧТО ВНУТРИ БОКСА */
        .services-section { padding: 70px 8%; max-width: 1300px; margin: 0 auto; }
        .section-title { font-size: 38px; font-weight: 800; color: var(--text-light); margin-bottom: 14px; text-align: center; }
        .section-subtitle { text-align: center; color: var(--bronze); font-size: 13px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 45px; }
        
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 22px; }
        .card {
            background: var(--bg-card); border: 1px solid var(--border-color); padding: 26px;
            border-radius: 18px; display: flex; align-items: flex-start; gap: 18px;
            transition: all 0.35s ease; cursor: pointer; position: relative; overflow: hidden;
        }
        .card:hover { transform: translateY(-6px); border-color: var(--bronze); background: var(--bg-card-hover); box-shadow: 0 12px 30px rgba(0,0,0,0.5); }
        .card-number {
            font-family: 'Cinzel', serif; font-size: 20px; font-weight: 800; color: var(--bronze);
            background: rgba(197, 131, 72, 0.1); border: 1px solid rgba(197, 131, 72, 0.3);
            width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .card-body h3 { font-size: 17px; font-weight: 800; color: var(--text-light); margin-bottom: 6px; }
        .card-body p { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; }

        /* МАГАЗИН / КАРТОЧКИ ТОВАРОВ */
        .pricing-section { padding: 80px 8%; max-width: 1250px; margin: 0 auto; }
        .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; margin-top: 20px; }
        .pricing-card {
            background: var(--bg-card); border-radius: 22px; padding: 36px 30px;
            border: 1px solid var(--border-color); display: flex; flex-direction: column;
            justify-content: space-between; transition: all 0.35s ease; position: relative;
        }
        .pricing-card:hover { transform: translateY(-8px); border-color: var(--bronze); box-shadow: 0 20px 45px rgba(0,0,0,0.6); }
        .pricing-card.featured {
            border: 2px solid var(--bronze);
            background: linear-gradient(180deg, #1A140F 0%, #121212 100%);
            box-shadow: 0 15px 40px rgba(197, 131, 72, 0.15);
        }
        .badge-popular {
            position: absolute; top: -13px; right: 24px; background: var(--bronze); color: #0D0D0D;
            padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
        }
        .pricing-header h4 { font-size: 22px; font-weight: 800; color: var(--text-light); margin-bottom: 6px; }
        .pricing-rate { font-size: 38px; font-weight: 800; color: var(--bronze); margin: 16px 0 12px; }
        .pricing-rate span { font-size: 14px; font-weight: 500; color: var(--text-muted); }
        .pricing-desc { font-size: 14px; color: var(--text-muted); line-height: 1.65; margin-bottom: 25px; }
        .pricing-features { list-style: none; margin-bottom: 28px; font-size: 13.5px; color: var(--text-light); }
        .pricing-features li { margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
        .pricing-features li::before { content: '✓'; color: var(--bronze); font-weight: 800; }

        .pricing-btn {
            width: 100%; padding: 15px 20px; background: var(--bronze); color: #0D0D0D;
            border-radius: 12px; font-size: 15px; font-weight: 800; border: none; cursor: pointer;
            transition: all 0.25s ease; text-align: center; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .pricing-btn:hover { background: var(--bronze-light); transform: translateY(-2px); }

        /* СЛАЙДЕР ГАЛЕРЕИ */
        .gallery-section { padding: 70px 8%; max-width: 1000px; margin: 0 auto; }
        .slider-container {
            position: relative; background: var(--bg-card); border-radius: 24px; overflow: hidden;
            border: 1px solid var(--border-color); box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        .slider-track { display: flex; transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1); width: 100%; }
        .slider-slide { min-width: 100%; box-sizing: border-box; display: flex; flex-direction: column; }
        .slider-img-wrap { position: relative; width: 100%; height: 480px; background: #080808; }
        .slider-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
        .slider-tag {
            position: absolute; top: 20px; left: 20px; background: rgba(13, 13, 13, 0.85);
            backdrop-filter: blur(10px); color: var(--bronze); padding: 7px 18px; border-radius: 30px;
            font-size: 12px; font-weight: 800; letter-spacing: 1.5px; border: 1px solid var(--bronze);
        }
        .slider-info { padding: 24px 30px; background: var(--bg-card); border-top: 1px solid var(--border-color); }
        .slider-info h4 { font-size: 20px; font-weight: 800; color: var(--text-light); margin-bottom: 6px; }
        .slider-info p { font-size: 14px; color: var(--text-muted); line-height: 1.5; }

        .slider-btn {
            position: absolute; top: 240px; transform: translateY(-50%); width: 46px; height: 46px;
            background: rgba(13, 13, 13, 0.85); border: 1px solid var(--bronze); color: var(--bronze);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 18px; cursor: pointer; z-index: 10; transition: all 0.25s ease;
        }
        .slider-btn:hover { background: var(--bronze); color: #0D0D0D; transform: translateY(-50%) scale(1.1); }
        .slider-btn.prev { left: 20px; }
        .slider-btn.next { right: 20px; }

        .slider-dots { display: flex; justify-content: center; gap: 8px; padding: 14px 0 18px; background: var(--bg-card); }
        .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.2); cursor: pointer; transition: all 0.3s ease; }
        .dot.active { background: var(--bronze); width: 26px; border-radius: 10px; }

        /* FAQ АККОРДЕОН */
        .faq-section { padding: 70px 8%; max-width: 960px; margin: 0 auto; }
        .faq-accordion { display: flex; flex-direction: column; gap: 14px; }
        .faq-item {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 16px; overflow: hidden; transition: all 0.3s ease;
        }
        .faq-item.active { border-color: var(--bronze); }
        .faq-question {
            padding: 22px 26px; font-size: 16px; font-weight: 700; color: var(--text-light);
            cursor: pointer; display: flex; justify-content: space-between; align-items: center; user-select: none;
        }
        .faq-question:hover { color: var(--bronze); }
        .faq-icon { font-size: 20px; font-weight: 700; color: var(--bronze); transition: transform 0.3s ease; }
        .faq-item.active .faq-icon { transform: rotate(45deg); }
        .faq-answer {
            max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.35s ease;
            padding: 0 26px; font-size: 14px; line-height: 1.65; color: var(--text-muted);
        }
        .faq-item.active .faq-answer { padding: 0 26px 24px; max-height: 350px; }

        /* ОТЗЫВЫ */
        .reviews-section { padding: 70px 8%; max-width: 1250px; margin: 0 auto; text-align: center; }
        .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 35px; text-align: left; }
        .review-card { background: var(--bg-card); border: 1px solid var(--border-color); padding: 28px; border-radius: 20px; position: relative; }
        .review-stars { color: var(--bronze); font-size: 18px; margin-bottom: 12px; letter-spacing: 2px; }
        .review-text { font-size: 14.5px; line-height: 1.65; color: var(--text-light); margin-bottom: 18px; font-style: italic; }
        .review-author { font-size: 13px; font-weight: 700; color: var(--bronze); }

        /* МОДАЛЬНЫЕ ОКНА И КОРЗИНА (CHECKOUT) */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(12px); z-index: 99999; align-items: center; justify-content: center; }
        .modal-content {
            background: #141414; color: var(--text-light); padding: 36px 38px; border-radius: 24px;
            border: 1px solid var(--bronze); max-width: 620px; width: 92%; max-height: 90vh;
            overflow-y: auto; position: relative; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8);
        }
        .modal-close { position: absolute; top: 20px; right: 25px; font-size: 28px; cursor: pointer; color: var(--text-muted); }
        .modal-close:hover { color: var(--bronze); }

        .progress-bar-wrap { width: 100%; height: 5px; background: rgba(255,255,255,0.1); border-radius: 10px; margin-bottom: 22px; overflow: hidden; }
        .progress-bar-fill { height: 100%; width: 33.33%; background: linear-gradient(90deg, var(--bronze), var(--bronze-light)); transition: width 0.4s ease; }
        
        .step-heading { font-size: 12px; font-weight: 800; color: var(--bronze); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 16px; }
        .form-step { display: none; animation: fadeIn 0.3s ease; }
        .form-step.active { display: block; }

        .sa-field { margin-bottom: 16px; text-align: left; }
        .sa-label { display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
        .sa-input, .sa-select, .sa-textarea {
            width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid rgba(197, 131, 72, 0.35);
            background-color: #0D0D0D; font-size: 14px; color: var(--text-light); outline: none; transition: all 0.25s; font-family: inherit;
        }
        .sa-input:focus, .sa-select:focus, .sa-textarea:focus { border-color: var(--bronze); box-shadow: 0 0 0 3px rgba(197, 131, 72, 0.15); }

        .order-summary-box {
            background: rgba(197, 131, 72, 0.08); border: 1px solid var(--border-color);
            padding: 16px 20px; border-radius: 14px; margin: 18px 0; display: flex; justify-content: space-between; align-items: center;
        }
        .order-total-price { font-size: 24px; font-weight: 800; color: var(--bronze); }

        .step-nav-buttons { display: flex; gap: 12px; margin-top: 22px; }
        .btn-step-next, .sa-submit-btn {
            flex: 2; background: var(--bronze); color: #0D0D0D; padding: 15px; border-radius: 12px;
            font-size: 15px; font-weight: 800; border: none; cursor: pointer; transition: all 0.25s; font-family: inherit;
        }
        .btn-step-next:hover, .sa-submit-btn:hover:not(:disabled) { background: var(--bronze-light); transform: translateY(-2px); }
        .sa-submit-btn:disabled { background: #333; color: #666; cursor: not-allowed; }
        .btn-step-prev {
            flex: 1; background: rgba(255,255,255,0.08); color: var(--text-light); padding: 15px;
            border-radius: 12px; font-size: 14px; font-weight: 700; border: none; cursor: pointer; font-family: inherit;
        }

        .dsgvo-checkbox-group { display: flex; align-items: flex-start; gap: 10px; margin: 16px 0; font-size: 13px; color: var(--text-muted); text-align: left; }
        .dsgvo-checkbox-group input { margin-top: 3px; accent-color: var(--bronze); width: 16px; height: 16px; cursor: pointer; }
        .dsgvo-checkbox-group a { color: var(--bronze); text-decoration: underline; }

        /* ФУТЕР */
        footer { background: #080808; border-top: 1px solid var(--border-color); padding: 70px 8% 35px; margin-top: 60px; }
        .footer-content { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 40px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 40px; }
        .footer-logo { font-family: 'Cinzel', serif; font-size: 28px; font-weight: 800; color: var(--bronze); letter-spacing: 2px; }
        .footer-contacts p { margin-bottom: 8px; color: var(--text-muted); font-size: 14px; }
        .footer-contacts a { color: var(--text-light); text-decoration: none; font-weight: 600; }
        .footer-bottom { max-width: 1200px; margin: 25px auto 0; display: flex; justify-content: space-between; flex-wrap: wrap; font-size: 13px; color: var(--text-muted); }
        .footer-bottom button { background: none; border: none; color: var(--text-muted); cursor: pointer; text-decoration: underline; margin-left: 18px; font-family: inherit; }
        .footer-bottom button:hover { color: var(--bronze); }

        /* COOKIE BANNER */
        .cookie-modal {
            position: fixed; bottom: 25px; right: 25px; max-width: 400px; background: #161616;
            padding: 24px; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            border: 1px solid var(--bronze); z-index: 9999;
        }
        .btn-cookie-accept { padding: 11px; background: var(--bronze); color: #0D0D0D; border: none; border-radius: 10px; font-weight: 800; cursor: pointer; font-family: inherit; }
        .btn-cookie-deny { padding: 11px; background: #262626; color: var(--text-light); border: none; border-radius: 10px; font-weight: 600; cursor: pointer; font-family: inherit; }

        .legal-text-body h4 { color: var(--bronze); margin: 18px 0 6px; font-size: 16px; }
        .legal-text-body p { color: var(--text-muted); font-size: 13.5px; line-height: 1.6; margin-bottom: 10px; }

        @media (max-width: 992px) {
            .hero-title { font-size: 38px; }
            .slider-img-wrap { height: 300px; }
            .slider-btn { top: 150px; }
            nav { display: none; }
        }
    </style>
</head>
<body>

    <div class="video-bg-container">
        <video autoplay loop muted playsinline id="bgVideo">
            <source src="./video.mp4" type="video/mp4">
        </video>
    </div>
    <div class="video-overlay"></div>

    <div id="toastNotification" class="toast-notification">
        <span id="toast-txt">✨ Gutscheincode LYS10 kopiert!</span>
